        {"kind":"text-insert","id":{"client":2,"clock":4},"row":{"client":1,"clock":1},"column":{"client":1,"clock":2},"after":{"client":2,"clock":3},"char":"字"},
        {"kind":"text-insert","id":{"client":1,"clock":4},"row":{"client":1,"clock":1},"column":{"client":1,"clock":2},"after":{"client":1,"clock":3},"char":"乙"},
        {"kind":"text-insert","id":{"client":3,"clock":1},"row":{"client":1,"clock":1},"column":{"client":2,"clock":2},"after":null,"char":"右"},
        {"kind":"text-insert","id":{"client":3,"clock":2},"row":{"client":2,"clock":1},"column":{"client":1,"clock":2},"after":null,"char":"下"},
        {"kind":"axis-insert","id":{"client":2,"clock":1},"axis":"row","after":{"client":1,"clock":1}},
        {"kind":"axis-insert","id":{"client":2,"clock":2},"axis":"column","after":{"client":1,"clock":2}},
        {"kind":"text-insert","id":{"client":2,"clock":3},"row":{"client":1,"clock":1},"column":{"client":1,"clock":2},"after":null,"char":"🙂"},
        {"kind":"text-insert","id":{"client":1,"clock":3},"row":{"client":1,"clock":1},"column":{"client":1,"clock":2},"after":null,"char":"甲"},
        {"kind":"axis-insert","id":{"client":1,"clock":2},"axis":"column","after":null},
        {"kind":"axis-insert","id":{"client":1,"clock":1},"axis":"row","after":null}
      ],
      "expected": {"grid":[["🙂字甲乙","右"],["下",""]],"pending":0,"rejected":[]}
    },
    {
