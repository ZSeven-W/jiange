        {"kind":"text-insert","id":{"client":2,"clock":3},"row":{"client":1,"clock":1},"column":{"client":1,"clock":2},"after":{"client":1,"clock":3},"char":"Z"},
        {"kind":"text-insert","id":{"client":1,"clock":3},"row":{"client":1,"clock":1},"column":{"client":1,"clock":2},"after":null,"char":"A"},
        {"kind":"axis-insert","id":{"client":1,"clock":1},"axis":"row","after":null},
