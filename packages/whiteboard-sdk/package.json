{
  "name": "@jiange/whiteboard-sdk",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./mindmap": "./src/mindmap.ts",
    "./history": "./src/history.ts",
    "./viewport": "./src/viewport.ts",
    "./inkGeometry": "./src/ink-geometry.ts",
    "./ink-geometry": "./src/ink-geometry.ts",
    "./xmind": "./src/xmind.ts",
    "./comment-anchor": "./src/comment-anchor.ts",
    "./mermaid": "./src/mermaid.ts",
    "./svg": "./src/svg.ts",
    "./board": "./src/board.ts",
    "./ai-tools": "./src/ai-tools.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./model": {
        "types": "./dist/model.d.ts",
        "import": "./dist/model.js"
      },
      "./mindmap": {
        "types": "./dist/mindmap.d.ts",
        "import": "./dist/mindmap.js"
      },
      "./history": {
        "types": "./dist/history.d.ts",
        "import": "./dist/history.js"
      },
      "./viewport": {
        "types": "./dist/viewport.d.ts",
        "import": "./dist/viewport.js"
      },
      "./inkGeometry": {
        "types": "./dist/ink-geometry.d.ts",
        "import": "./dist/ink-geometry.js"
      },
      "./ink-geometry": {
        "types": "./dist/ink-geometry.d.ts",
        "import": "./dist/ink-geometry.js"
      },
      "./xmind": {
        "types": "./dist/xmind.d.ts",
        "import": "./dist/xmind.js"
      },
      "./comment-anchor": {
        "types": "./dist/comment-anchor.d.ts",
        "import": "./dist/comment-anchor.js"
      },
      "./mermaid": {
        "types": "./dist/mermaid.d.ts",
        "import": "./dist/mermaid.js"
      },
      "./svg": {
        "types": "./dist/svg.d.ts",
        "import": "./dist/svg.js"
      },
      "./board": {
        "types": "./dist/board.d.ts",
        "import": "./dist/board.js"
      },
      "./ai-tools": {
        "types": "./dist/ai-tools.d.ts",
        "import": "./dist/ai-tools.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@jiange/ooxml": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
