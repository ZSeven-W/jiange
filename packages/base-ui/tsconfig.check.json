{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@zseven-w/base-sdk": ["../base-sdk/src/index.ts"],
      "@zseven-w/base-sdk/*": ["../base-sdk/src/*.ts"],
      "@zseven-w/render-gpu": ["../render-gpu/src/index.ts"],
      "@zseven-w/render-gpu/*": ["../render-gpu/src/*.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
