{
  "name": "@zseven-w/sheet-ui",
  "version": "0.2.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./renderer": "./src/sheet-renderer.ts",
    "./controller": "./src/controller.ts",
    "./mount": "./src/mount.ts",
    "./react": "./src/react.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./renderer": {
        "types": "./dist/sheet-renderer.d.ts",
        "import": "./dist/sheet-renderer.js"
      },
      "./controller": {
        "types": "./dist/controller.d.ts",
        "import": "./dist/controller.js"
      },
      "./mount": {
        "types": "./dist/mount.d.ts",
        "import": "./dist/mount.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@zseven-w/render-gpu": "workspace:*",
    "@zseven-w/sheet-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/ZSeven-W/jiange#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZSeven-W/jiange.git",
    "directory": "packages/sheet-ui"
  },
  "bugs": {
    "url": "https://github.com/ZSeven-W/jiange/issues"
  },
  "keywords": [
    "jiange",
    "spreadsheet",
    "ui",
    "webgpu",
    "webgl2",
    "virtual-grid",
    "react",
    "web-components"
  ]
}
