{
  "name": "@jiange/collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:vectors": "tsx scripts/gen-vectors.ts",
    "build": "node ../../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
