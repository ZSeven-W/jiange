{
  "name": "@jiange/sheet-ui",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./renderer": "./src/sheet-renderer.ts",
    "./controller": "./src/controller.ts",
    "./mount": "./src/mount.ts",
    "./react": "./src/react.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./renderer": {
        "types": "./dist/sheet-renderer.d.ts",
        "import": "./dist/sheet-renderer.js"
      },
      "./controller": {
        "types": "./dist/controller.d.ts",
        "import": "./dist/controller.js"
      },
      "./mount": {
        "types": "./dist/mount.d.ts",
        "import": "./dist/mount.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@jiange/render-gpu": "workspace:*",
    "@jiange/sheet-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
