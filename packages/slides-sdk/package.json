{
  "name": "@jiange/slides-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./shape-state": "./src/shape-state.ts",
    "./shape-order": "./src/shape-order.ts",
    "./shape-resize": "./src/shape-resize.ts",
    "./line-endpoints": "./src/line-endpoints.ts",
    "./order": "./src/order.ts",
    "./layout": "./src/layout.ts",
    "./visibility": "./src/visibility.ts",
    "./zoom": "./src/zoom.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./shape-state": {
        "types": "./dist/shape-state.d.ts",
        "import": "./dist/shape-state.js"
      },
      "./shape-order": {
        "types": "./dist/shape-order.d.ts",
        "import": "./dist/shape-order.js"
      },
      "./shape-resize": {
        "types": "./dist/shape-resize.d.ts",
        "import": "./dist/shape-resize.js"
      },
      "./line-endpoints": {
        "types": "./dist/line-endpoints.d.ts",
        "import": "./dist/line-endpoints.js"
      },
      "./order": {
        "types": "./dist/order.d.ts",
        "import": "./dist/order.js"
      },
      "./layout": {
        "types": "./dist/layout.d.ts",
        "import": "./dist/layout.js"
      },
      "./visibility": {
        "types": "./dist/visibility.d.ts",
        "import": "./dist/visibility.js"
      },
      "./zoom": {
        "types": "./dist/zoom.d.ts",
        "import": "./dist/zoom.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
