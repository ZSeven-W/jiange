{
  "name": "@jiange/collab",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./table": "./src/table.ts",
    "./ws": "./src/ws.ts",
    "./storage": "./src/storage.ts",
    "./ai-agent": "./src/ai-agent.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:vectors": "tsx scripts/gen-vectors.ts",
    "build": "node ../../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./table": {
        "types": "./dist/table.d.ts",
        "import": "./dist/table.js"
      },
      "./ws": {
        "types": "./dist/ws.d.ts",
        "import": "./dist/ws.js"
      },
      "./storage": {
        "types": "./dist/storage.d.ts",
        "import": "./dist/storage.js"
      },
      "./ai-agent": {
        "types": "./dist/ai-agent.d.ts",
        "import": "./dist/ai-agent.js"
      }
    }
  }
}
