{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@zseven-w/base-sdk": ["../base-sdk/dist/index.d.ts"],
      "@zseven-w/base-sdk/*": ["../base-sdk/dist/*.d.ts"],
      "@zseven-w/render-gpu": ["../render-gpu/dist/index.d.ts"],
      "@zseven-w/render-gpu/*": ["../render-gpu/dist/*.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
