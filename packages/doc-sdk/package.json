{
  "name": "@jiange/doc-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./tableCells": "./src/table-cells.ts",
    "./blockStyles": "./src/block-styles.ts",
    "./columnWidths": "./src/column-widths.ts",
    "./columnMove": "./src/column-move.ts",
    "./docx": "./src/docx.ts",
    "./markdown": "./src/markdown.ts",
    "./zip": "./src/zip.ts",
    "./xml": "./src/xml.ts",
    "./table-cells": "./src/table-cells.ts",
    "./block-styles": "./src/block-styles.ts",
    "./column-widths": "./src/column-widths.ts",
    "./column-move": "./src/column-move.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./model": {
        "types": "./dist/model.d.ts",
        "import": "./dist/model.js"
      },
      "./tableCells": {
        "types": "./dist/table-cells.d.ts",
        "import": "./dist/table-cells.js"
      },
      "./blockStyles": {
        "types": "./dist/block-styles.d.ts",
        "import": "./dist/block-styles.js"
      },
      "./columnWidths": {
        "types": "./dist/column-widths.d.ts",
        "import": "./dist/column-widths.js"
      },
      "./columnMove": {
        "types": "./dist/column-move.d.ts",
        "import": "./dist/column-move.js"
      },
      "./docx": {
        "types": "./dist/docx.d.ts",
        "import": "./dist/docx.js"
      },
      "./markdown": {
        "types": "./dist/markdown.d.ts",
        "import": "./dist/markdown.js"
      },
      "./zip": {
        "types": "./dist/zip.d.ts",
        "import": "./dist/zip.js"
      },
      "./xml": {
        "types": "./dist/xml.d.ts",
        "import": "./dist/xml.js"
      },
      "./table-cells": {
        "types": "./dist/table-cells.d.ts",
        "import": "./dist/table-cells.js"
      },
      "./block-styles": {
        "types": "./dist/block-styles.d.ts",
        "import": "./dist/block-styles.js"
      },
      "./column-widths": {
        "types": "./dist/column-widths.d.ts",
        "import": "./dist/column-widths.js"
      },
      "./column-move": {
        "types": "./dist/column-move.d.ts",
        "import": "./dist/column-move.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@jiange/collab": "workspace:*",
    "@jiange/whiteboard-sdk": "workspace:*",
    "@jiange/ooxml": "workspace:*"
  }
}
