{
  "name": "@jiange/base-ui",
  "version": "0.2.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base-view": "./src/base-view.ts",
    "./react": "./src/react.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./base-view": {
        "types": "./dist/base-view.d.ts",
        "import": "./dist/base-view.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@jiange/base-sdk": "workspace:*",
    "@jiange/render-gpu": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/ZSeven-W/jiange#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZSeven-W/jiange.git",
    "directory": "packages/base-ui"
  },
  "bugs": {
    "url": "https://github.com/ZSeven-W/jiange/issues"
  },
  "keywords": [
    "jiange",
    "base",
    "bitable",
    "ui",
    "webgpu",
    "webgl2",
    "virtual-grid",
    "gantt",
    "kanban"
  ]
}
