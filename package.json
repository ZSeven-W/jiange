{
  "name": "jiange",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "gen:vectors": "pnpm --filter @jiange/collab gen:vectors",
    "test:sdk:pack": "node scripts/verify-headless-sdks.mjs",
    "test:xlsx:interop": "node scripts/verify-xlsx-interop.mjs",
    "test:sdk:coverage": "pnpm --filter @jiange/ooxml --filter @jiange/collab --filter @jiange/doc-sdk --filter @jiange/sheet-sdk --filter @jiange/slides-sdk --filter @jiange/whiteboard-sdk --filter @jiange/base-sdk --filter @jiange/render-gpu --filter @jiange/sheet-ui --filter @jiange/doc-ui --filter @jiange/slides-ui --filter @jiange/whiteboard-ui --filter @jiange/base-ui exec vitest run --coverage --coverage.include 'src/**/*.ts' --coverage.reporter=text --coverage.thresholds.statements=100 --coverage.thresholds.lines=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100",
    "bench": "node benchmarks/run-benchmarks.mjs",
    "test:cli": "cd cli && go test -count=1 -race -cover ./...",
    "test:sdk:go": "cd sdk/go && go test -count=1 -race -cover ./...",
    "lint:names": "node scripts/check-file-names.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.9"
  }
}
